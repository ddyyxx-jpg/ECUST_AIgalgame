# 测试期用免费端点（ecust）。真实 key 只放本地 .env，进 .gitignore。
GALGAME_LLM_BASE_URL=https://ai.ecustcic.com/api/v1
GALGAME_LLM_MODEL=deepseek-v4.1-flash
GALGAME_LLM_API_KEY=sk-xxxxxxxx
GALGAME_PORT=8787

# 审核器：必须是与叙事模型不同家族的强模型（DeepSeek 系容易被同一套破甲提示词带走）。
# 三项必须独立配置（不继承上面 LLM_*，也不写死模型名）；缺任意一项 → NoopAudit（放行）+ 启动告警，只适合本地开发。
# GALGAME_AUDIT_BASE_URL=https://ai.ecustcic.com/api/v1
# GALGAME_AUDIT_MODEL=<另一个家族的强模型，名字只写在本地 .env>
# GALGAME_AUDIT_API_KEY=sk-xxxxxxxx

# 简易用户系统（部署示例；本地调试可把 AUTH_REQUIRED 设为 0）
GALGAME_AUTH_REQUIRED=1
GALGAME_INVITE_CODE=change-me-invite
GALGAME_SECURE_COOKIES=1
GALGAME_SESSION_TTL_DAYS=7
GALGAME_ADMIN_TOKEN=change-me-admin

# 反代部署（Nginx 在同机转发）：设 1 才信任 X-Forwarded-For，限流按真实客户端 IP 计；
# 直连部署保持 0，否则客户端可伪造 X-Forwarded-For 绕过限流。
GALGAME_TRUST_PROXY=0
# Cookie 写请求的 CSRF Origin 白名单（必须等于浏览器地址栏的源，含协议；IP 部署写 https://<公网IP>）。
# AUTH_REQUIRED=1 时必填，否则带会话的写请求会因 Origin 不符被 403。
GALGAME_PUBLIC_ORIGIN=https://change-me-origin
# 管理员签发的一次性重置凭证有效期（分钟）
GALGAME_RESET_TTL_MIN=15

# 本地开发（P1-2）：AUTH_REQUIRED=0 时前端提供「访客进入」，无需邀请码；
# 旧 X-User-Id 兜底仍可用。要体验完整注册流程，设 AUTH_REQUIRED=1 + 一个 GALGAME_INVITE_CODE，
# 注册页填该邀请码即可；或停服后跑 `npx tsx scripts/admin-init.ts <用户名>`（密码走 GALGAME_ADMIN_PASSWORD）
# 建管理员，再用管理端点 POST /api/v1/admin/invites 签发一次性邀请。
